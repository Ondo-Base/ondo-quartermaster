# Every setting here is read from the process environment. Nothing in this
# repository loads a .env file for you, so copy this one and source it before
# starting anything:
#
#   cp .env.example .env
#   set -a; source .env; set +a
#   npm run dev
#
# .env is gitignored; this file is committed, so keep real credentials out of it.
# Secrets belong here and nowhere else: ondo.yaml, config/profiles.yaml and
# deploy/litellm.yaml name environment variables rather than holding their values.
#
# The control plane and web UI need none of this: `npm run dev` already sets
# ONDO_DEV=1 and ONDO_SEED=demo. The agent now defaults to OpenRouter, so it
# wants OPENROUTER_API_KEY below — set ONDO_MODEL_PROFILE=demo instead to run the
# scripted stand-in, which talks to no provider at all.


# --- Control plane (server) -------------------------------------------------

# Development affordances: the built-in identity provider page and the HTTP
# outbox that carries verification codes. Never set this in production.
ONDO_DEV=1

# Load the sample Northwind organisation on boot. `demo` is the only value that
# does anything.
ONDO_SEED=demo

# Signs session cookies. The one genuine secret the server needs: required in
# production and rejected below 32 characters. With ONDO_DEV=1 an insecure
# placeholder is substituted, which is why the demo starts without it.
#   openssl rand -hex 32
ONDO_COOKIE_SECRET=

# Defaults are shown. ONDO_PUBLIC_URL also decides cookie security: an https://
# URL turns on secure cookies, so set it to the real origin behind TLS.
# PORT=8787
# HOST=127.0.0.1
# ONDO_PUBLIC_URL=http://localhost:8787
# ONDO_DB=ondo.sqlite

# Serve a built web bundle from the control plane instead of running Vite.
# ONDO_WEB_DIST=../web/dist

# Members of this group reach the admin console.
# ONDO_ADMIN_GROUP=ondo-admins

# How often the audit stream is flushed to the SIEM, in milliseconds.
# ONDO_SIEM_INTERVAL_MS=5000


# --- Single sign-on ---------------------------------------------------------
#
# Leave both blocks empty to keep the development identity provider. Setting
# ONDO_OIDC_ISSUER or ONDO_SAML_ENTRY_POINT switches the server onto that method.

# ONDO_OIDC_ISSUER=
# ONDO_OIDC_CLIENT_ID=
# ONDO_OIDC_CLIENT_SECRET=

# ONDO_SAML_ENTRY_POINT=
# ONDO_SAML_ISSUER=ondo-quartermaster
# ONDO_SAML_IDP_CERT=

# What the sign-in screen calls your identity provider.
# ONDO_SSO_LABEL=your identity provider


# --- Agent: model access (OpenRouter) ---------------------------------------
#
# Everything model-facing goes through OpenRouter for now: one OpenAI-compatible
# endpoint, one key, provider/model slugs. Get a key at openrouter.ai/keys.
OPENROUTER_API_KEY=

# Which profile from agent/config/profiles.yaml the orchestrator runs on.
# `openrouter` is the default; `demo` is the scripted stand-in that needs no key
# and no network; `gateway` is a self-hosted LiteLLM; `messages` is the second
# wire format.
ONDO_MODEL_PROFILE=openrouter

# The slugs the two OpenRouter profiles resolve to. Defaults shown; any slug from
# openrouter.ai/models works, and the model list is worth re-checking since these
# move. Both profiles read OPENROUTER_API_KEY.
# ONDO_ORCHESTRATOR_MODEL=anthropic/claude-sonnet-5
# ONDO_EXTRACTOR_MODEL=anthropic/claude-haiku-4.5
# ONDO_OPENROUTER_URL=https://openrouter.ai/api/v1


# --- Agent: other model routes ----------------------------------------------
#
# Unused while ONDO_MODEL_PROFILE=openrouter. Kept because the profiles are still
# in config/profiles.yaml and the failover path can still reach them.

# The `gateway` profile: a self-hosted LiteLLM (see deploy/litellm.yaml) or any
# other OpenAI-compatible endpoint.
# ONDO_GATEWAY_URL=http://localhost:4000
# ONDO_GATEWAY_KEY=

# The `messages` profile: the second wire format.
# ONDO_MESSAGES_URL=
# ONDO_MESSAGES_KEY=
# ONDO_MESSAGES_MODEL=orchestrator

# Calling a provider directly, bypassing OpenRouter entirely. Each falls back to
# the unprefixed name (ANTHROPIC_API_KEY, OPENAI_API_KEY) when it is unset.
# ONDO_ANTHROPIC_API_KEY=
# ONDO_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# ONDO_OPENAI_API_KEY=
# ONDO_OPENAI_BASE_URL=https://api.openai.com/v1

# decision.provider `jev` calls Jev through OpenRouter's System One API
# (https://openrouter.ai/api/v1/systemone, model typesafe/jev-1.13) with the same
# OPENROUTER_API_KEY as above; no separate key. See agent/src/ondo_agent/decision/jev.py.


# --- Agent: browser and desktop ---------------------------------------------

# A Chromium for the browser rung, when `npx playwright install chromium` has
# not put one where Playwright looks. Referenced by ondo.yaml as
# browser.executable_path.
# ONDO_CHROMIUM=

# Override the command that starts Playwright MCP. By default the copy in this
# repository's node_modules is preferred, then npx.
# ONDO_PLAYWRIGHT_MCP=


# --- LiteLLM gateway (deploy/litellm.yaml) ----------------------------------
#
# Read by the gateway process, not by the agent, and unused while we are on
# OpenRouter. For when a self-hosted gateway replaces it: point the aliases at
# the providers you hold contracts with.
# ORCHESTRATOR_PRIMARY=
# ORCHESTRATOR_PRIMARY_KEY=
# ORCHESTRATOR_SECONDARY=
# ORCHESTRATOR_SECONDARY_KEY=
# EXTRACTOR_SELF_HOSTED=
# EXTRACTOR_API_BASE=
